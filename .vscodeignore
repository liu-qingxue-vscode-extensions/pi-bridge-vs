# 扩展运行需要的是 dist/ + media/ + svg/ + package.json
# 其余都是【开发时才需要】的东西 ✗ 不该进 vsix

# ── 源码与构建输入 ──
src/**
**/*.ts
tsconfig*.json
webview-src/

# ── 开发资料 ──
docs/**
test_date/**
scripts/**
.vscode/**
.gitignore
.git/**
svg/README*           
node_modules/

# ── 杂项 ──
**/*.map
**/.DS_Store
**/*.log
.directory
my/
typeDocs/
typedoc.json
.pi-tours/ 