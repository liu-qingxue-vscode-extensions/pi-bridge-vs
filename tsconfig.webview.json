{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2022", "dom","DOM.Iterable"],
    "types": [],
    "rootDir": ".",
