{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        // ★ 位置参数 = 新窗口【打开哪个目录】（不是扩展路径）
        //   用固定的测试工作区 ⇒ 提案落盘不会改到本项目的源码
        "/tmp/test-vs"
      ],
      "outFiles": [
        "${workspaceFolder}/dist/**/*.js"
      ],
      "preLaunchTask": "prep-and-compile"
    }
  ]
}