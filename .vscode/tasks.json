{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "清理 pi-bridge 日志",
      "type": "shell",
      "command": "rm -rf \"$HOME\"/.local/state/VSCodium/*/window*/exthost/liu-qingxue.pi-bridge-vs/* \"$HOME\"/.config/VSCodium/logs/*/window*/exthost/liu-qingxue.pi-bridge-vs/* 2>/dev/null || true",
      "presentation": {
        "reveal": "silent",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "type": "npm",
      "script": "compile",
      "problemMatcher": "$tsc",
      "options": {
        "env": {
          "PATH": "${env:PATH}:/home/qingyuxue/.local/bin"
        }
      },
      "label": "npm: compile"
    },
    {
      "label": "prep-and-compile",
      "dependsOrder": "sequence",
      "dependsOn": [
        "npm: compile"
      ],
      "problemMatcher": []
    }
  ]
}